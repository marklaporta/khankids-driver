# Copy to local.env and fill in. local.env is gitignored; scripts and kk.py read it at startup.
# Values set in the environment override the file.

# Devices. UDID: `xcrun xctrace list devices` or Finder. CDID (CoreDevice id): `xcrun devicectl list devices`.
# Fill in only the device(s) you use: the iPad (default) and/or an iPhone (run scripts with KK_DEVICE=iphone).
KK_IPAD_UDID=
KK_IPAD_CDID=
KK_IPHONE_UDID=
KK_IPHONE_CDID=
# Fallback Wi-Fi address of the iPhone when it isn't plugged in (the start script saves the latest one automatically).
KK_IPHONE_WIFI_IP=

# Signing for the WebDriverAgent runner: your Apple Developer team id and a bundle id you own.
KK_APPLE_TEAM_ID=
KK_WDA_BUNDLE_ID=com.example.WebDriverAgentRunner

# Khan Academy Kids teacher profile, as shown on the app's profile picker.
KK_TEACHER_NAME=
# Case-insensitive text that identifies your Google account in the sign-in sheet (part of the email or name).
KK_GOOGLE_ACCOUNT_MATCH=
